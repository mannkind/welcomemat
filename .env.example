# --- Required in production (ASPNETCORE_ENVIRONMENT=Production) ---

BASE_URL=https://example.com

GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# --- Required once, to bootstrap the very first administrator ---

INITIAL_USER=admin@example.com

# --- Optional ---

# Listen address. Default: :8080
LISTEN_ADDR=:8080

STATE_PATH=./state

# SQLite database file path. Default: <STATE_PATH>/reservations.db
DATABASE_PATH=./state/reservations.db

PUSHOVER_TOKEN=
PUSHOVER_USER_TOKEN=

GEOCODING_BASE_URL=
# Set to false to disable outbound geocoding entirely. Default: true
GEOCODING_ENABLED=true

TRUSTED_PROXIES=
TRUSTED_NETWORKS=

WELCOMEMAT_TEST_AUTH=
