{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "leaflet"
    ],
    "rootDir": "WelcomeMat/Scripts",
    "outDir": "WelcomeMat/wwwroot",
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "WelcomeMat/Scripts/**/*.ts"
  ]
}
